<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#navigation');
  const backdrop = document.querySelector<HTMLElement>('.menu-backdrop');

  const closeMenu = () => { 
    nav?.classList.remove('is-open'); 
    backdrop?.classList.remove('is-active');
    document.body.classList.remove('menu-open');
    toggle?.setAttribute('aria-expanded','false'); 
    toggle?.setAttribute('aria-label','Abrir menu'); 
  };
  
  const openMenu = () => {
    nav?.classList.add('is-open');
    backdrop?.classList.add('is-active');
    document.body.classList.add('menu-open');
    toggle?.setAttribute('aria-expanded','true');
    toggle?.setAttribute('aria-label','Fechar menu');
  };

  toggle?.addEventListener('click', () => { 
    const isOpen = nav?.classList.contains('is-open');
    if (isOpen) closeMenu();
    else openMenu();
  });

  backdrop?.addEventListener('click', closeMenu);
  nav?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => { 
    if (event.key === 'Escape') { closeMenu(); toggle?.focus(); } 
  });

  const form = document.querySelector<HTMLFormElement>('.booking-form');
  const date = form?.querySelector<HTMLInputElement>('[name="data"]');
  if(date) { 
    const today = new Date(); 
    date.min = [today.getFullYear(),String(today.getMonth()+1).padStart(2,'0'),String(today.getDate()).padStart(2,'0')].join('-'); 
  }
  form?.addEventListener('submit', event => {
    event.preventDefault();
    if(!form.reportValidity()) return;
    const data = new FormData(form);
    const selectedDate = String(data.get('data')).split('-').reverse().join('/');
    const message = `Olá! Sou ${data.get('nome')}. Gostaria de solicitar ${data.get('servico')} na unidade ${data.get('unidade')}, para ${selectedDate}. Telefone: ${data.get('telefone')}. Observações: ${data.get('observacoes') || 'Nenhuma'}.`;
    window.open(`https://wa.me/${form.dataset.whatsapp}?text=${encodeURIComponent(message)}`,'_blank','noopener,noreferrer');
  });

  window.addEventListener('load', () => {
    document.querySelectorAll<HTMLElement>('a').forEach((link) => {
      if (!/[↗→]/.test(link.textContent ?? '') || link.querySelector('[data-lucide]')) return;
      link.innerHTML = link.innerHTML.replace(/[↗→]/g, '');
      const icon = document.createElement('i'); 
      icon.dataset.lucide = 'arrow-up-right'; 
      link.append(icon);
    });
    const lucide = (window as Window & { lucide?: { createIcons: () => void } }).lucide; 
    lucide?.createIcons();
  });
</script>
