  </a>

  <!-- Barra Fixa Inferior Mobile (Ergonomia ICP) -->
  <aside class="mobile-bottom-bar" aria-label="Ações rápidas no celular">
    <a href="tel:+556536423588" class="mobile-bar-btn call" aria-label="Ligar para plantão 24h">
      <i data-lucide="phone-call" aria-hidden="true"></i>
      <span>Ligar 24h</span>
    </a>
    <a href={contact('Olá, preciso de atendimento para meu pet.')} target="_blank" rel="noreferrer" class="mobile-bar-btn whatsapp" aria-label="Conversar no WhatsApp da emergência">
      <i data-lucide="message-circle" aria-hidden="true"></i>
      <span>WhatsApp 24h</span>
    </a>
    <a href="#agendamento" class="mobile-bar-btn booking" aria-label="Ir para agendamento">
